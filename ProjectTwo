#making a method that looks through both databases and searches for "on build 2/24/2024" and a verbose for it

def query_date (db_name, collection1, collection2):
    client = pymongo.MongoClient("mongodb+srv://lancestajimenez_db_user:wcHp8TWnJvdYi74Y@testcluster.vb9fgy4.mongodb.net/")
    db = client[db_name]
    col1 = db[collection1]
    col2 = db[collection2]
    # query for 2/24/2024 (match records for that calendar date)
    start_date = datetime.datetime(2024, 2, 24)
    end_date = start_date + datetime.timedelta(days=1)
    query1 = {
        'Build #': {
            '$gte': start_date,
            '$lt': end_date
        }
    }

    results1 = list(col1.find(query1))
    results2 = list(col2.find(query1))
    df1 = pd.DataFrame(results1)
    df2 = pd.DataFrame(results2)
    dfProcessing = pd.concat([df1, df2], ignore_index = True, sort = False)
    #drop duplicates 
    dfFinal = dfProcessing.drop_duplicates(subset=["Test Case", "Test #", "Expected Result", "Actual Result"]) 
    dfFinal.to_csv("SpecifiedDate.csv", index = False, header = True)
    print(f"'Specfic Date' database query file generated!")


